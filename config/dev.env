# GCP Dev environment
ENVIRONMENT=dev
DEPLOYMENT_STRATEGY=on_cloud

# GCP Project
PROJECT_ID=drone-fleet-dev
GCP_REGION=europe-west1

# Pub/Sub Topics (auto-created by Terraform)
PUBSUB_TOPIC_TELEMETRY=telemetry
PUBSUB_TOPIC_ORDERS=orders
PUBSUB_TOPIC_COMMANDS=commands

# Cloud Run URLs (set by Terraform outputs)
STATE_MANAGER_URL=https://state-manager-dev-xxxxxxxxx-ew.a.run.app
OPTIMIZER_URL=https://optimizer-dev-xxxxxxxxx-ew.a.run.app

# Logging
LOG_LEVEL=DEBUG

# Feature Flags (pour tester de nouvelles fonctionnalités)
FEATURE_BATTERY_OPTIMIZATION=true
FEATURE_ADVANCED_VRP=false