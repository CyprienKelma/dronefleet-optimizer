# GCP Production environment
ENVIRONMENT=prod
DEPLOYMENT_STRATEGY=on_cloud

# GCP Project
PROJECT_ID=drone-fleet-optimizer-prod
GCP_REGION=europe-west1

# Pub/Sub Topics
PUBSUB_TOPIC_TELEMETRY=telemetry
PUBSUB_TOPIC_ORDERS=orders
PUBSUB_TOPIC_COMMANDS=commands

# Cloud Run URLs
STATE_MANAGER_URL=https://state-manager-prod-xxxxxxxxx-ew.a.run.app
OPTIMIZER_URL=https://optimizer-prod-xxxxxxxxx-ew.a.run.app

# Logging
LOG_LEVEL=INFO

# Monitoring
ENABLE_PROFILING=true
METRICS_EXPORT_INTERVAL=10
