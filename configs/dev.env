# GCP Dev environment
ENVIRONMENT=dev
DEPLOYMENT_STRATEGY=on_cloud
FIRESTORE_COLLECTION_DRONES=drones
FIRESTORE_COLLECTION_ORDERS=orders
FIRESTORE_COLLECTION_MISSIONS=missions
FIRESTORE_COLLECTION_WAREHOUSES=warehouses
FIRESTORE_COLLECTION_DEPOTS=depots
PUBSUB_TOPIC_DECISIONS=decisions

# optimizer Settings
SOLVER_TIME_LIMIT_SECONDS=8
MIN_BATTERY_THRESHOLD=20

# GCP Project
PROJECT_ID=drone-fleet-optimizer-dev
GCP_REGION=europe-west1

# pub/sub (auto-created by Terraform)
PUBSUB_TOPIC_TELEMETRY=telemetry
PUBSUB_TOPIC_ORDERS=orders
PUBSUB_TOPIC_COMMANDS=commands
PUBSUB_TOPIC_DECISIONS=decisions

# cloud run url (set by tf outputs)
STATE_MANAGER_URL=https://state-manager-dev-x-ew.a.run.app
OPTIMIZER_URL=https://optimizer-dev-x-ew.a.run.app

# logging level
LOG_LEVEL=DEBUG

# monitoring
ENABLE_PROFILING=true
METRICS_EXPORT_INTERVAL=60

# terraform variables
FIRESTORE_LOCATION=eur3
BUDGET_AMOUNT=5
